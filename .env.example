# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.
# Every variable is optional in Phase 0 — with none set the app runs in guest mode.

# Public site URL (used for auth redirects and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). The publishable key (or legacy anon key) is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never prefix with NEXT_PUBLIC_. Used for lead capture/admin jobs (Phase 3).
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (Phase 1). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Register the service worker during `next dev` (off by default; it caches aggressively)
NEXT_PUBLIC_ENABLE_SW_IN_DEV=false

# Email list provider (Phase 3): none | kit | mailchimp | webhook
EMAIL_PROVIDER=none
KIT_API_KEY=
KIT_WAITLIST_FORM_ID=
KIT_NEWSLETTER_FORM_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
LEADS_WEBHOOK_URL=

# AI coach (Phase 4): none | gemini | anthropic
AI_PROVIDER=none
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe (Phase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
